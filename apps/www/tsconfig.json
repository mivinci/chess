{
  "extends": ["$app/tsconfig", "../../tsconfig.json"],
  "compilerOptions": {
    "types": ["$app/types", "./worker-configuration.d.ts"],
    "paths": {
      "#lib": ["./src/lib"],
      "#lib/*": ["./src/lib/*"],
      "#lib/components": ["./src/lib/components"],
      "#lib/components/*": ["./src/lib/components/*"],
      "#lib/components/ui": ["./src/lib/components/ui"],
      "#lib/components/ui/*": ["./src/lib/components/ui/*"],
      "#lib/utils": ["./src/lib/utils"],
      "#lib/hooks": ["./src/lib/hooks"]
    }
  },
  "include": ["src", "vite.config.ts"],
  "exclude": [".svelte-kit/**", "node_modules/**"]
}
