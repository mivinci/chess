{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "chinese-chess-room",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-16",
  "vars": {
    "ROOM_TOKEN_SECRET": "dev-only-change-me-in-production"
  },
  "routes": [
    {
      "pattern": "chess-room.le0.me",
      "custom_domain": true
    }
  ],
  "ratelimits": [
    {
      "name": "WS_CONNECT_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_ROOM",
        "class_name": "GameRoom"
      },
      {
        "name": "MATCH_QUEUE",
        "class_name": "MatchQueue"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GameRoom"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["MatchQueue"]
    }
  ]
}
