{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "chinese-chess-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-16",
  "d1_databases": [
    {
      "binding": "BOARDS_DB",
      "database_name": "chinese-chess-boards",
      "database_id": "73b519ca-163f-40d3-adce-161f28f36c56"
    }
  ],
  "routes": [
    {
      "pattern": "api.chess.le0.me",
      "custom_domain": true
    }
  ],
  "ratelimits": [
    {
      "name": "WS_CONNECT_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_ROOM",
        "class_name": "GameRoom"
      },
      {
        "name": "MATCH_QUEUE",
        "class_name": "MatchQueue"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GameRoom"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["MatchQueue"]
    }
  ]
}
